# Copy this file to .env.local and fill in real values. Never commit
# .env.local — it's already covered by .gitignore's `.env*` rule.

# --- Site ---

# Public: your production URL (no trailing slash). Used for canonical
# links, sitemap.xml, robots.txt, and Open Graph image URLs. Falls back to
# http://localhost:3000 in dev if unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings > API in the Supabase dashboard) ---

# Public: safe to expose to the browser (rows are still protected by RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-ONLY. Bypasses Row Level Security entirely — never prefix this with
# NEXT_PUBLIC_, never import it from a Client Component, and never send it
# to the browser. Only used in server-only code (route handlers, server
# actions) that needs to act outside a user's own RLS-scoped access.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare R2 file storage (dash.cloudflare.com > R2) ---
# All uploaded files (screenshots, icons, music, project thumbnails) and the
# public files (template preview videos, music library) live in R2. Setup
# steps: CLAUDE.md "File storage (Cloudflare R2)". Without these set, the
# editor still works but uploads aren't saved.

# SERVER-ONLY. Your Cloudflare account id (R2 overview page, right side).
R2_ACCOUNT_ID=
# SERVER-ONLY. An R2 API token's S3 credentials (R2 > Manage API tokens,
# "Object Read & Write", scoped to the two buckets below). Never expose these
# to the browser — the browser only ever gets short-lived signed URLs.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# SERVER-ONLY. Bucket names: the private one holds user uploads; the public
# one holds template previews and the music library.
R2_PRIVATE_BUCKET=nimina-private
R2_PUBLIC_BUCKET=nimina-public
# Public: the public bucket's URL (its r2.dev URL or a custom domain), no
# trailing slash. Used by the browser to load music-library tracks.
NEXT_PUBLIC_R2_PUBLIC_URL=

# --- Paddle Billing (paddle.com dashboard) ---

# Public: Paddle.js's client-side token (Developer Tools > Authentication).
# Designed to be exposed to the browser — it's how Paddle.js opens checkout.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=

# Public: 'sandbox' while testing, 'production' when you go live.
NEXT_PUBLIC_PADDLE_ENV=sandbox

# No price ID env vars here — Pro monthly/yearly and the one-time Lifetime
# price are created and stored at runtime (the `pricing_config` table,
# src/lib/paddle/catalog.ts), set from /admin/pricing rather than pasted in
# here. /pricing shows "Coming soon" for any of the three an admin hasn't
# set an amount for yet.

# SERVER-ONLY. Paddle API key (Developer Tools > Authentication) — used to
# create/manage products and prices (see /admin/pricing), create customer
# portal sessions, and verify webhooks. Never expose to the browser.
PADDLE_API_KEY=

# SERVER-ONLY. Webhook signing secret (Developer Tools > Notifications >
# your webhook destination). Used to verify that /api/webhooks/paddle
# requests actually came from Paddle.
PADDLE_WEBHOOK_SECRET=

# --- Anthropic (console.anthropic.com) ---

# SERVER-ONLY. Powers the editor's "AI Director" feature (/api/ai/director),
# which looks at a slide's screenshot and suggests a headline/animation/
# effect, and "Detect elements" (/api/ai/detect-elements), which finds
# buttons/cards/list items/bubbles on a screenshot as cutout suggestions,
# and the Languages tab's "Translate all" (/api/ai/translate), which
# translates a project's copy into another language for review.
# Without this set, those buttons stay visible but explain they aren't
# configured yet instead of crashing (see src/lib/ai/config.ts).
ANTHROPIC_API_KEY=
